# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is in .gitignore, so your real passwords never reach GitHub.

# --- PostgreSQL (Postgres.app defaults: user = your Mac username, no password) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=flights
# Postgres.app: run `whoami` in Terminal and put that name here
PGUSER=your_mac_username
PGPASSWORD=

# --- How much history to keep (rolling window, in months) ---
# Start small while developing (1 or 3), then raise to 12 or 24.
MONTHS_BACK=3

# --- Optional: AWS S3 raw archive ---
# Leave S3_BUCKET empty to keep raw ZIP files on your computer in data/archive/.
# Fill it in (plus AWS keys) to archive every raw file in S3 instead.
S3_BUCKET=
S3_PREFIX=raw/bts_ontime
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional ---
LOG_LEVEL=INFO
